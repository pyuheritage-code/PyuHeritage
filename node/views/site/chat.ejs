<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pyu Chat - ပျူအကြောင်းမေးမြန်းရန်</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>

<body
    class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white transition-colors duration-300 h-screen flex flex-col overflow-hidden">
    <!-- nav_section -->
    <nav
        class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50 flex-shrink-0">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <!-- Start: Logo -->
                <div class="flex-shrink-0 flex items-center">
                    <a href="/" class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">ပျူအမွေအနှစ်</a>
                </div>

                <!-- Center: Navigation Links (Desktop) -->
                <div class="hidden md:flex flex-1 justify-center space-x-8">
                    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium">ပင်မစာမျက်နှာ</a>
                    <a href="/chat"
                        class="text-indigo-600 dark:text-indigo-400 font-medium border-b-2 border-indigo-600 dark:border-indigo-400">ပျူအကြောင်းမေးမြန်းရန်</a>
                </div>

                <!-- End: Theme Changer (Desktop) -->
                <div class="flex items-center space-x-4">
                    <% if (user) { %>
                        <div class="hidden md:flex items-center space-x-3">
                            <%- include('partials/profile-menu') %>
                        </div>
                    <% } else { %>
                        <div class="hidden md:flex items-center space-x-2">
                            <a href="/auth/signin" class="px-4 py-1.5 text-sm font-medium bg-indigo-600 hover:bg-indigo-700 text-white rounded-full shadow transition">Sign In</a>
                        </div>
                    <% } %>
                    <% if (!user) { %>
                    <button id="theme-toggle"
                        class="p-2 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 focus:outline-none">
                        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor"
                            viewBox="0 0 20 20">
                            <path
                                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z">
                            </path>
                        </svg>
                        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                        </svg>
                    </button>
                    <% } %>
                    <!-- Mobile Hamburger -->
                    <button id="mobile-menu-button"
                        class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu"
            class="hidden md:hidden bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
            <div class="px-2 pt-2 pb-3 space-y-1">
                <a href="/"
                    class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 dark:hover:bg-gray-700">ပင်မစာမျက်နှာ</a>
                <a href="/chat"
                    class="block px-3 py-2 rounded-md text-base font-medium bg-indigo-50 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400">ပျူအကြောင်းမေးမြန်းရန်</a>
                <% if (user) { %>
                    <div class="px-3 py-3 flex items-center space-x-3 border-t border-gray-200 dark:border-gray-700">
                        <% if (user.picture) { %>
                            <img src="<%= user.picture %>" alt="<%= user.name %>" class="w-9 h-9 rounded-full object-cover">
                        <% } else { %>
                            <span class="w-9 h-9 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold"><%= user.name ? user.name[0].toUpperCase() : 'U' %></span>
                        <% } %>
                        <span class="text-base font-medium truncate"><%= user.name %></span>
                    </div>
                    <button id="mobile-change-username-btn" class="w-full text-left px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 dark:hover:bg-gray-700">Change Username</button>
                    <a href="/auth/logout" class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 dark:hover:bg-gray-700">Logout</a>
                <% } else { %>
                    <a href="/auth/signin" class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 dark:hover:bg-gray-700">Sign In</a>
                <% } %>
                <button id="mobile-theme-toggle"
                    class="w-full text-left px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 dark:hover:bg-gray-700 flex justify-between items-center">
                    <span>Theme</span>
                    <span id="theme-status" class="text-sm text-gray-500">Light</span>
                </button>
            </div>
        </div>
    </nav>
    <% if (user) { %>
    <%- include('partials/profile-modal') %>
    <% } %>
    <!-- /nav_section -->

    <!-- Main Chat Area -->
    <main
        class="flex-grow flex flex-col md:flex-row max-w-7xl w-full mx-auto gap-4 md:px-4 md:my-4 items-stretch relative min-h-0">
        <% if (user) { %>
        <!-- Conversation Sidebar -->
        <aside id="conversation-sidebar"
            class="hidden md:flex flex-col w-64 flex-shrink-0 bg-white dark:bg-gray-800 shadow-xl rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                <button id="new-chat-btn"
                    class="w-full bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl py-2.5 font-semibold transition flex items-center justify-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span>အသစ်စတင်မည်</span>
                </button>
            </div>
            <div class="flex-grow overflow-y-auto p-2 space-y-1 min-h-0">
                <div id="conversation-list" class="space-y-1"></div>
                <p id="no-conversations" class="hidden text-xs text-gray-500 dark:text-gray-400 text-center py-6 px-2">
                    ဆွေးနွေးမှု မှတ်တမ်းမရှိသေးပါ</p>
            </div>
            <div class="p-3 border-t border-gray-200 dark:border-gray-700">
                <div class="flex items-center space-x-2">
                    <% if (user.picture) { %>
                    <img src="<%= user.picture %>" alt="<%= user.name %>" class="w-7 h-7 rounded-full object-cover">
                    <% } %>
                    <span class="text-xs text-gray-600 dark:text-gray-300 truncate"><%= user.name %></span>
                </div>
            </div>
        </aside>
        <% } %>

        <div id="chat-panel"
            class="flex-grow flex flex-col bg-white dark:bg-gray-800 shadow-xl overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-700 relative min-h-0">
            <!-- Chat Header -->
        <div
            class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50 backdrop-blur-sm flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div
                    class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z">
                        </path>
                    </svg>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-gray-900 dark:text-white">Pyu Assistant</h2>
                    <p class="text-xs text-green-500 flex items-center">
                        <span class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></span>
                        Online
                    </p>
                </div>
            </div>
            <% if (user) { %>
            <button id="mobile-history-btn"
                class="md:hidden p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-600 dark:text-gray-300 focus:outline-none"
                aria-label="Chat history">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </button>
            <% } %>
        </div>

        <!-- Messages Container -->
        <div id="chat-messages" class="flex-grow overflow-y-auto p-4 md:p-6 space-y-4 scroll-smooth min-h-0">
            <!-- Bot Welcome Message -->
            <div class="flex justify-start">
                <div
                    class="max-w-[85%] md:max-w-[70%] bg-gray-100 dark:bg-gray-700 rounded-2xl px-4 py-3 text-gray-800 dark:text-gray-200 rounded-tl-none shadow-sm">
                    <p class="mb-2">မင်္ဂလာပါ! ပျူမြို့ဟောင်းများနှင့် ပတ်သက်ပြီး သိရှိလိုသည်များကို မေးမြန်းနိုင်ပါသည်။
                    </p>
                    <div class="flex flex-wrap gap-2 mt-3" id="suggestion-chips">
                        <button
                            class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors"
                            data-question="ဟန်လင်းမြို့ဟောင်းအကြောင်း ပြောပြပါ">ဟန်လင်းမြို့ဟောင်း</button>
                        <button
                            class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors"
                            data-question="ပျူမြို့ပြနိုင်ငံများအကြောင်း ရှင်းပြပါ">ပျူမြို့ပြနိုင်ငံများ</button>
                        <button
                            class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors"
                            data-question="ပျူလူမျိုးတို့၏ ယဉ်ကျေးမှုအကြောင်း ပြောပြပါ">ယဉ်ကျေးမှု</button>
                        <button
                            class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors"
                            data-question="ပျူဘာသာစကားအကြောင်း ပြောပြပါ">ပျူဘာသာစကား</button>
                        <button
                            class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors"
                            data-question="သရေခေတ္တရာမြို့ဟောင်းအကြောင်း သိချင်ပါတယ်">သရေခေတ္တရာ</button>
                    </div>
                    <span class="text-[10px] text-gray-500 mt-2 block">Just now</span>
                </div>
            </div>
        </div>

        <!-- Input Area -->
        <div
            class="p-4 bg-gray-50/50 dark:bg-gray-800/50 backdrop-blur-sm border-t border-gray-200 dark:border-gray-700">
            <form id="chat-form" class="flex items-center space-x-2">
                <div class="relative flex-grow">
                    <input type="text" id="user-input" placeholder="ဒီနေရာမှာ မေးမြန်းနိုင်ပါတယ်..."
                        class="w-full bg-white dark:bg-gray-700 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-600 rounded-full py-3 px-6 pr-12 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner">
                    <button type="button"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-indigo-500 transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                    </button>
                </div>
                <button type="submit"
                    class="bg-indigo-600 hover:bg-indigo-700 text-white p-3 rounded-full transition-all shadow-lg active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg class="w-6 h-6 transform rotate-90" fill="currentColor" viewBox="0 0 20 20">
                        <path
                            d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z">
                        </path>
                    </svg>
                </button>
            </form>
            <p class="text-[10px] text-center text-gray-500 mt-2">© 2026 PyuHeritage Project</p>
        </div>
        </div>
    </main>

    <% if (user) { %>
    <!-- Mobile Conversation History Drawer -->
    <div id="mobile-history-overlay"
        class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden opacity-0 md:hidden"></div>
    <aside id="mobile-history-drawer"
        class="md:hidden fixed top-0 left-0 bottom-0 w-72 max-w-[85%] bg-white dark:bg-gray-800 shadow-2xl border-r border-gray-200 dark:border-gray-700 transform -translate-x-full transition-transform duration-300 ease-in-out z-50 flex flex-col overflow-hidden">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
            <h3 class="text-sm font-bold text-gray-900 dark:text-white">ဆွေးနွေးမှုမှတ်တမ်း</h3>
            <button id="mobile-history-close"
                class="p-1.5 rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none"
                aria-label="Close history">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        <div class="p-4 border-b border-gray-200 dark:border-gray-700">
            <button id="mobile-new-chat-btn"
                class="w-full bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl py-2.5 font-semibold transition flex items-center justify-center space-x-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <span>အသစ်စတင်မည်</span>
            </button>
        </div>
        <div class="flex-grow overflow-y-auto p-2 space-y-1 min-h-0">
            <div id="mobile-conversation-list" class="space-y-1"></div>
            <p id="mobile-no-conversations"
                class="hidden text-xs text-gray-500 dark:text-gray-400 text-center py-6 px-2">ဆွေးနွေးမှု
                မှတ်တမ်းမရှိသေးပါ</p>
        </div>
        <div class="p-3 border-t border-gray-200 dark:border-gray-700">
            <div class="flex items-center space-x-2">
                <% if (user.picture) { %>
                <img src="<%= user.picture %>" alt="<%= user.name %>" class="w-7 h-7 rounded-full object-cover">
                <% } %>
                <span class="text-xs text-gray-600 dark:text-gray-300 truncate"><%= user.name %></span>
            </div>
        </div>
    </aside>
    <% } %>

    <script>
        // Theme Toggle Logic (Same as index.ejs)
        const themeToggleBtn = document.getElementById('theme-toggle');
        const mobileThemeToggleBtn = document.getElementById('mobile-theme-toggle');
        const themeStatus = document.getElementById('theme-status');
        const darkIcon = document.getElementById('theme-toggle-dark-icon');
        const lightIcon = document.getElementById('theme-toggle-light-icon');

        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
            if (lightIcon) lightIcon.classList.remove('hidden');
            if (themeStatus) themeStatus.textContent = 'Dark';
        } else {
            document.documentElement.classList.remove('dark');
            if (darkIcon) darkIcon.classList.remove('hidden');
            if (themeStatus) themeStatus.textContent = 'Light';
        }

        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('color-theme', 'light');
                lightIcon?.classList.add('hidden');
                darkIcon?.classList.remove('hidden');
                if (themeStatus) themeStatus.textContent = 'Light';
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('color-theme', 'dark');
                darkIcon?.classList.add('hidden');
                lightIcon?.classList.remove('hidden');
                if (themeStatus) themeStatus.textContent = 'Dark';
            }
        }

        themeToggleBtn?.addEventListener('click', toggleTheme);
        mobileThemeToggleBtn?.addEventListener('click', toggleTheme);

        // Mobile Menu Toggle
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuButton.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Chat History (logged-in users only)
        const currentUser = <%- JSON.stringify(user || null) %>;
        let activeConversationId = null;
        let latestConversationId = null;

        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        function formatConversationTime(iso) {
            const d = new Date(iso);
            if (isNaN(d.getTime())) return '';
            const diffMin = Math.floor((Date.now() - d.getTime()) / 60000);
            if (diffMin < 1) return 'Just now';
            if (diffMin < 60) return diffMin + ' min ago';
            const diffHrs = Math.floor(diffMin / 60);
            if (diffHrs < 24) return diffHrs + ' hr ago';
            return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
        }

        function showWelcomeMessage() {
            chatMessages.innerHTML = `
                <div class="flex justify-start">
                    <div class="max-w-[85%] md:max-w-[70%] bg-gray-100 dark:bg-gray-700 rounded-2xl px-4 py-3 text-gray-800 dark:text-gray-200 rounded-tl-none shadow-sm">
                        <p class="mb-2">မင်္ဂလာပါ! ပျူမြို့ဟောင်းများနှင့် ပတ်သက်ပြီး သိရှိလိုသည်များကို မေးမြန်းနိုင်ပါသည်။</p>
                        <div class="flex flex-wrap gap-2 mt-3">
                            <button class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors" data-question="ဟန်လင်းမြို့ဟောင်းအကြောင်း ပြောပြပါ">ဟန်လင်းမြို့ဟောင်း</button>
                            <button class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors" data-question="ပျူမြို့ပြနိုင်ငံများအကြောင်း ရှင်းပြပါ">ပျူမြို့ပြနိုင်ငံများ</button>
                            <button class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors" data-question="ပျူလူမျိုးတို့၏ ယဉ်ကျေးမှုအကြောင်း ပြောပြပါ">ယဉ်ကျေးမှု</button>
                            <button class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors" data-question="ပျူဘာသာစကားအကြောင်း ပြောပြပါ">ပျူဘာသာစကား</button>
                            <button class="suggestion-chip text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full hover:bg-indigo-200 dark:hover:bg-indigo-800/60 transition-colors" data-question="သရေခေတ္တရာမြို့ဟောင်းအကြောင်း သိချင်ပါတယ်">သရေခေတ္တရာ</button>
                        </div>
                        <span class="text-[10px] text-gray-500 mt-2 block">Just now</span>
                    </div>
                </div>`;
            attachSuggestionChips();
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function attachSuggestionChips() {
            document.querySelectorAll('.suggestion-chip').forEach(chip => {
                chip.addEventListener('click', () => {
                    const question = chip.dataset.question;
                    if (question && !isStreaming) sendMessage(question);
                });
            });
        }

        function renderConversationList(listEl, emptyEl, convos) {
            if (!listEl) return;
            listEl.innerHTML = '';
            if (!convos || convos.length === 0) {
                if (emptyEl) emptyEl.classList.remove('hidden');
                return;
            }
            if (emptyEl) emptyEl.classList.add('hidden');
            convos.forEach(c => {
                const item = document.createElement('div');
                item.className = 'group flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-700 transition ' + (activeConversationId === c.id ? 'bg-gray-100 dark:bg-gray-700' : '');
                item.innerHTML = `
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-800 dark:text-gray-200 truncate">${escapeHtml(c.title || 'New chat')}</p>
                        <p class="text-[10px] text-gray-500">${formatConversationTime(c.updated_at)}</p>
                    </div>
                    <button class="conversation-delete md:opacity-0 md:group-hover:opacity-100 text-gray-400 hover:text-red-500 p-1 transition" data-id="${c.id}" title="Delete">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>`;
                item.addEventListener('click', (e) => {
                    if (e.target.closest('.conversation-delete')) return;
                    openConversation(c.id);
                });
                listEl.appendChild(item);
            });
            listEl.querySelectorAll('.conversation-delete').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    deleteConversation(btn.dataset.id);
                });
            });
        }

        async function loadConversations() {
            if (!currentUser) return;
            const res = await fetch('/chat/history');
            if (!res.ok) return;
            const convos = await res.json();
            latestConversationId = null;
            renderConversationList(document.getElementById('conversation-list'), document.getElementById('no-conversations'), convos);
            renderConversationList(document.getElementById('mobile-conversation-list'), document.getElementById('mobile-no-conversations'), convos);
            if (convos && convos.length > 0) latestConversationId = convos[0].id;
        }

        async function openConversation(id) {
            if (!currentUser) return;
            const res = await fetch('/chat/conversations/' + id);
            if (!res.ok) return;
            const data = await res.json();
            activeConversationId = id;
            chatMessages.innerHTML = '';
            (data.messages || []).forEach(m => {
                addMessage(m.content, m.role === 'user');
            });
            await loadConversations();
            chatMessages.scrollTop = chatMessages.scrollHeight;
            closeMobileHistory();
        }

        function startNewChat() {
            activeConversationId = null;
            showWelcomeMessage();
            loadConversations();
        }

        async function deleteConversation(id) {
            if (!currentUser) return;
            const res = await fetch('/chat/conversations/' + id, { method: 'DELETE' });
            if (!res.ok) return;
            if (activeConversationId == id) {
                activeConversationId = null;
                showWelcomeMessage();
            }
            loadConversations();
        }

        // Mobile History Drawer
        const mobileHistoryBtn = document.getElementById('mobile-history-btn');
        const mobileHistoryDrawer = document.getElementById('mobile-history-drawer');
        const mobileHistoryOverlay = document.getElementById('mobile-history-overlay');
        const mobileHistoryClose = document.getElementById('mobile-history-close');

        function openMobileHistory() {
            if (!mobileHistoryDrawer || !mobileHistoryOverlay) return;
            mobileHistoryDrawer.classList.remove('-translate-x-full');
            mobileHistoryOverlay.classList.remove('hidden');
            mobileHistoryOverlay.offsetHeight;
            mobileHistoryOverlay.classList.remove('opacity-0');
        }

        function closeMobileHistory() {
            if (!mobileHistoryDrawer || !mobileHistoryOverlay) return;
            mobileHistoryDrawer.classList.add('-translate-x-full');
            mobileHistoryOverlay.classList.add('opacity-0');
            setTimeout(() => {
                mobileHistoryOverlay.classList.add('hidden');
            }, 300);
        }

        mobileHistoryBtn?.addEventListener('click', openMobileHistory);
        mobileHistoryClose?.addEventListener('click', closeMobileHistory);
        mobileHistoryOverlay?.addEventListener('click', closeMobileHistory);
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeMobileHistory();
        });

        // Chat Interaction Logic
        const chatForm = document.getElementById('chat-form');
        const userInput = document.getElementById('user-input');
        const chatMessages = document.getElementById('chat-messages');
        const suggestionChips = document.querySelectorAll('.suggestion-chip');
        let isStreaming = false;

        function addMessage(text, isUser = false) {
            const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const messageDiv = document.createElement('div');
            messageDiv.className = `flex ${isUser ? 'justify-end' : 'justify-start'} animate-fadeIn`;

            const bubble = document.createElement('div');
            bubble.className = `max-w-[85%] md:max-w-[70%] ${isUser ? 'bg-indigo-600 text-white rounded-tr-none' : 'bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-tl-none'} rounded-2xl px-4 py-3 shadow-sm`;

            const p = document.createElement('p');
            p.textContent = text;

            const span = document.createElement('span');
            span.className = `text-[10px] ${isUser ? 'text-indigo-200 text-right' : 'text-gray-500'} mt-1 block`;
            span.textContent = time;

            bubble.appendChild(p);
            bubble.appendChild(span);
            messageDiv.appendChild(bubble);

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            return bubble;
        }

        function createBotBubble() {
            const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const messageDiv = document.createElement('div');
            messageDiv.className = 'flex justify-start animate-fadeIn';

            const bubble = document.createElement('div');
            bubble.className = 'max-w-[85%] md:max-w-[70%] bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-tl-none rounded-2xl px-4 py-3 shadow-sm';

            const p = document.createElement('p');
            p.id = 'streaming-text';

            const thinking = document.createElement('div');
            thinking.id = 'thinking-indicator';
            thinking.className = 'flex items-center space-x-1.5';
            thinking.innerHTML = `
                <span class="text-sm text-gray-500 dark:text-gray-400">ခနစောင့်ပါ</span>
                <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay:0s"></span>
                <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay:0.15s"></span>
                <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay:0.3s"></span>
            `;
            p.appendChild(thinking);

            const span = document.createElement('span');
            span.className = 'text-[10px] text-gray-500 mt-1 block';
            span.textContent = time;

            bubble.appendChild(p);
            bubble.appendChild(span);
            messageDiv.appendChild(bubble);

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            return { p, thinking };
        }

        async function sendMessage(text) {
            if (isStreaming) return;
            isStreaming = true;
            userInput.disabled = true;
            document.querySelector('#chat-form button[type="submit"]').disabled = true;

            addMessage(text, true);
            const { p: textElement, thinking } = createBotBubble();

            try {
                const response = await fetch('/chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'text/event-stream'
                    },
                    body: JSON.stringify({ message: text, conversationId: activeConversationId })
                });

                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                let gotFirstToken = false;

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;

                    buffer += decoder.decode(value, { stream: true });
                    const lines = buffer.split('\n');
                    buffer = lines.pop();

                    for (const line of lines) {
                        const trimmed = line.trim();
                        if (!trimmed || trimmed === 'data: [DONE]') continue;
                        if (trimmed.startsWith('data: ')) {
                            try {
                                const parsed = JSON.parse(trimmed.slice(6));
                                if (parsed.conversationId) {
                                    activeConversationId = parsed.conversationId;
                                }
                                if (parsed.content) {
                                    if (!gotFirstToken) {
                                        gotFirstToken = true;
                                        thinking.remove();
                                        textElement.textContent = '';
                                    }
                                    textElement.textContent += parsed.content;
                                    chatMessages.scrollTop = chatMessages.scrollHeight;
                                }
                                if (parsed.error) {
                                    thinking.remove();
                                    textElement.textContent = parsed.error;
                                }
                            } catch (e) { }
                        }
                    }
                }

                if (!gotFirstToken) {
                    thinking.remove();
                    textElement.textContent = '';
                }
            } catch (error) {
                console.error('Error:', error);
                thinking.remove();
                textElement.textContent = "ကွန်နက်ရှင် အမှားတစ်ခုဖြစ်သွားပါသည်။";
            }

            isStreaming = false;
            userInput.disabled = false;
            document.querySelector('#chat-form button[type="submit"]').disabled = false;
            userInput.focus();
            if (currentUser) loadConversations();
        }

        chatForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const text = userInput.value.trim();
            if (text) {
                sendMessage(text);
                userInput.value = '';
            }
        });

        // Suggestion chips
        suggestionChips.forEach(chip => {
            chip.addEventListener('click', () => {
                const question = chip.dataset.question;
                if (question && !isStreaming) {
                    sendMessage(question);
                }
            });
        });

        // Logged-in user init: load conversations & auto-open most recent
        if (currentUser) {
            const newChatBtn = document.getElementById('new-chat-btn');
            if (newChatBtn) newChatBtn.addEventListener('click', startNewChat);
            const mobileNewChatBtn = document.getElementById('mobile-new-chat-btn');
            if (mobileNewChatBtn) mobileNewChatBtn.addEventListener('click', () => {
                startNewChat();
                closeMobileHistory();
            });
            loadConversations().then(() => {
                if (latestConversationId) {
                    openConversation(latestConversationId);
                } else {
                    showWelcomeMessage();
                }
            });
        }

        // Auto-scroll to bottom on load
        chatMessages.scrollTop = chatMessages.scrollHeight;
    </script>

    <style>
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fadeIn {
            animation: fadeIn 0.3s ease-out forwards;
        }
    </style>
</body>

</html>