    <script>
        // Slider Logic
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const indicators = document.querySelectorAll('.absolute.bottom-8 button');

        function showSlide(index) {
            slides.forEach(s => s.classList.remove('active'));
            indicators.forEach(i => i.classList.replace('bg-white', 'bg-white/50'));

            slides[index].classList.add('active');
            indicators[index].classList.replace('bg-white/50', 'bg-white');
            currentSlide = index;
        }

        function nextSlide() {
            let next = (currentSlide + 1) % slides.length;
            showSlide(next);
        }

        function setSlide(index) {
            showSlide(index);
            resetTimer();
        }

        let slideInterval = setInterval(nextSlide, 5000);

        function resetTimer() {
            clearInterval(slideInterval);
            slideInterval = setInterval(nextSlide, 5000);
        }

        // Initialize indicators
        indicators[0].classList.replace('bg-white/50', 'bg-white');

        // Mobile Menu Toggle
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuButton.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Theme Toggle Logic
        const themeToggleBtn = document.getElementById('theme-toggle');
        const mobileThemeToggleBtn = document.getElementById('mobile-theme-toggle');
        const themeStatus = document.getElementById('theme-status');
        const darkIcon = document.getElementById('theme-toggle-dark-icon');
        const lightIcon = document.getElementById('theme-toggle-light-icon');

        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
            if (lightIcon) lightIcon.classList.remove('hidden');
            if (themeStatus) themeStatus.textContent = 'Dark';
        } else {
            document.documentElement.classList.remove('dark');
            if (darkIcon) darkIcon.classList.remove('hidden');
            if (themeStatus) themeStatus.textContent = 'Light';
        }

        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('color-theme', 'light');
                lightIcon?.classList.add('hidden');
                darkIcon?.classList.remove('hidden');
                if (themeStatus) themeStatus.textContent = 'Light';
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('color-theme', 'dark');
                darkIcon?.classList.add('hidden');
                lightIcon?.classList.remove('hidden');
                if (themeStatus) themeStatus.textContent = 'Dark';
            }
        }

        themeToggleBtn.addEventListener('click', toggleTheme);
        mobileThemeToggleBtn.addEventListener('click', toggleTheme);

        // History Dropdown Toggle Logic
        const historyDropdownBtn = document.getElementById('history-dropdown-btn');
        const historyDropdownMenu = document.getElementById('history-dropdown-menu');
        const historyArrow = document.getElementById('history-arrow');

        historyDropdownBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = historyDropdownMenu.classList.contains('hidden');

            if (isHidden) {
                historyDropdownMenu.classList.remove('hidden');
                historyArrow.classList.add('rotate-180');
            } else {
                historyDropdownMenu.classList.add('hidden');
                historyArrow.classList.remove('rotate-180');
            }
        });

        // Close dropdown when clicking outside
        window.addEventListener('click', (e) => {
            if (!historyDropdownBtn.contains(e.target) && !historyDropdownMenu.contains(e.target)) {
                historyDropdownMenu.classList.add('hidden');
                historyArrow.classList.remove('rotate-180');
            }
        });
    </script>
