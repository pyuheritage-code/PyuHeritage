<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PyuHeritage</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
    <style>
        .slide {
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
        }

        .slide.active {
            opacity: 1;
        }
    </style>
</head>

<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white transition-colors duration-300 overflow-x-hidden">
    <!-- nav_section -->
    <nav
        class="bg-gray-100/80 dark:bg-gray-800/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <!-- Start: Logo -->
                <div class="flex-shrink-0 flex items-center">
                    <span class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">ပျူအမွေအနှစ်</span>
                </div>

                <!-- Center: Navigation Links (Desktop) -->
                <div class="hidden md:flex flex-1 justify-center space-x-8">
                    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium">ပင်မစာမျက်နှာ</a>
                    <a href="/chat"
                        class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium">ပျူအကြောင်းမေးမြန်းရန်</a>

                    <!-- History Dropdown -->
                    <div class="relative">
                        <button id="history-dropdown-btn"
                            class="flex items-center hover:text-indigo-600 dark:hover:text-indigo-400 font-medium focus:outline-none transition-colors duration-200">
                            အကြောင်းအရာများ
                            <svg id="history-arrow" class="ml-1 w-4 h-4 transition-transform duration-200" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                        <div id="history-dropdown-menu"
                            class="absolute hidden left-0 mt-2 w-48 rounded-md shadow-lg bg-white dark:bg-gray-700 ring-1 ring-black ring-opacity-5 z-50">
                            <div class="py-1">
                                <a href="/history/cities"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">မြို့ပြနိုင်ငံများ</a>
                                <a href="/history/religion"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">သာသနာထွန်းကားမှု</a>
                                <a href="/history/language"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">ပျူဘာသာစကား
                                    နှင့် အက္ခရာ</a>
                                <a href="/history/culture"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">ယဉ်ကျေးမှု
                                    နှင့် ဘာသာရေး</a>
                                <a href="/history/artifacts"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">ရှေးဟောင်းသုတေသန
                                    ပစ္စည်းများ</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- End: Theme Changer (Desktop) -->
                <div class="hidden md:flex items-center">
                    <button id="theme-toggle"
                        class="p-2 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 focus:outline-none">
                        <!-- Sun Icon -->
                        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor"
                            viewBox="0 0 20 20">
                            <path
                                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z">
                            </path>
                        </svg>
                        <!-- Moon Icon -->
                        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                        </svg>
                    </button>
                </div>

                <!-- Mobile: Hamburger Menu Bar -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-button"
                        class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu"
            class="hidden md:hidden bg-gray-100 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
            <div class="px-2 pt-2 pb-3 space-y-1">
                <a href="/"
                    class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ပင်မစာမျက်နှာ</a>
                <a href="/chat"
                    class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ပျူအကြောင်းမေးမြန်းရန်</a>
                <div class="space-y-1">
                    <button
                        class="w-full text-left px-3 py-2 text-base font-medium text-gray-600 dark:text-gray-300">အကြောင်းအရာများ</button>
                    <a href="/history/cities"
                        class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700">မြို့ပြနိုင်ငံများ</a>
                    <a href="/history/religion"
                        class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700">သာသနာထွန်းကားမှု</a>
                    <a href="/history/language"
                        class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ပျူဘာသာစကား
                        နှင့် အက္ခရာ</a>
                    <a href="/history/culture"
                        class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ယဉ်ကျေးမှု
                        နှင့် ဘာသာရေး</a>
                    <a href="/history/artifacts"
                        class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ရှေးဟောင်းသုတေသန
                        ပစ္စည်းများ</a>
                    <a href="/history/artifacts/3d"
                        class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-700">3D
                        ရှေးဟောင်းပစ္စည်းများ</a>
                </div>
                <button id="mobile-theme-toggle"
                    class="w-full text-left px-3 py-2 rounded-md text-base font-medium hover:bg-gray-200 dark:hover:bg-gray-700 flex justify-between items-center">
                    <span>Theme</span>
                    <span id="theme-status" class="text-sm text-gray-500">Light</span>
                </button>
            </div>
        </div>
    </nav>
    <!-- /nav_section -->

    <!-- Slider Section -->
    <div class="relative h-[calc(100vh-64px)] w-full overflow-hidden">
        <!-- Slides -->
        <div id="slider" class="absolute inset-0">
            <div class="slide active absolute inset-0 bg-cover bg-center"
                style="background-image: url('/sri_ksetra.webp');">
                <div class="absolute inset-0 bg-black/40"></div>
            </div>
            <div class="slide absolute inset-0 bg-cover bg-center" style="background-image: url('/halin1.webp');">
                <div class="absolute inset-0 bg-black/40"></div>
            </div>
            <div class="slide absolute inset-0 bg-cover bg-center" style="background-image: url('/beikthano1.webp');">
                <div class="absolute inset-0 bg-black/40"></div>
            </div>
        </div>

        <!-- Hero Content Over Slider -->
        <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-4">
            <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-4 drop-shadow-2xl">ကမ္ဘာအမွေအနှစ်စာရင်းဝင်
                'ပျူ'</h1><br>
            <p class="text-xl md:text-2xl text-gray-200 max-w-2xl drop-shadow-lg">ပျူဆိုသည်မှာ ခရစ်တော်မပေါ်မီ (ဘီစီ
                ၁၀၀) ခန့်မှ အေဒီ ၉ ရာစုအထိ မြန်မာနိုင်ငံအလယ်ပိုင်း ဧရာဝတီမြစ်ဝှမ်းတစ်လျှောက်တွင် ထွန်းကားခဲ့သော
                တိဗက်-ဗမာနွယ်ဖွား ရှေးဦးမြို့ပြလူမျိုးများ ဖြစ်ကြသည်။</p>
            <div class="mt-8 flex space-x-4">
                <a href="#cities"
                    class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-full font-bold transition duration-300 shadow-lg">မြို့ပြနိုင်ငံများ</a>
                <a href="/chat"
                    class="bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white border border-white/50 px-8 py-3 rounded-full font-bold transition duration-300 shadow-lg">ပျူအကြောင်းမေးမြန်းရန်</a>
            </div>
        </div>

        <!-- Slider Indicators -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex space-x-3">
            <button class="w-3 h-3 rounded-full bg-white/50 hover:bg-white transition" onclick="setSlide(0)"></button>
            <button class="w-3 h-3 rounded-full bg-white/50 hover:bg-white transition" onclick="setSlide(1)"></button>
            <button class="w-3 h-3 rounded-full bg-white/50 hover:bg-white transition" onclick="setSlide(2)"></button>
        </div>
    </div>

    <!-- Main Content Section -->
    <main id="cities" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <!-- Featured Cities Heading -->
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">ကမ္ဘာ့အမွေအနှစ် ပျူမြို့ဟောင်း
                သုံးမြို့</h2>
            <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">ယူနက်စကို ကမ္ဘာ့အမွေအနှစ်စာရင်းဝင်
                မြန်မာနိုင်ငံ၏ ရှေးဟောင်း ပျူမြို့ပြနိုင်ငံများ</p>
        </div>

        <!-- Cities Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Halin Card -->
            <div
                class="group bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden transform hover:-translate-y-2 transition-all duration-300 border border-gray-100 dark:border-gray-700">
                <div class="relative h-64 overflow-hidden">
                    <img src="/halin.webp" alt="Halin"
                        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                    <h3 class="absolute bottom-4 left-6 text-2xl font-bold text-white">ဟန်လင်း</h3>
                </div>
                <div class="p-6">
                    <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-3">စစ်ကိုင်းတိုင်းဒေသကြီး၊
                        ဝက်လက်မြို့နယ်တွင် တည်ရှိပြီး ရှေးဟောင်းပျူမြို့ပြနိုင်ငံများထဲတွင် အကြီးဆုံးမြို့များထဲမှ
                        တစ်ခုဖြစ်သည်။</p>
                    <a href="/history/cities"
                        class="inline-flex items-center text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">
                        အသေးစိတ်ဖတ်ရန်
                        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                            </path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Beikthano Card -->
            <div
                class="group bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden transform hover:-translate-y-2 transition-all duration-300 border border-gray-100 dark:border-gray-700">
                <div class="relative h-64 overflow-hidden">
                    <img src="/beikthano.webp" alt="Beikthano"
                        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                    <h3 class="absolute bottom-4 left-6 text-2xl font-bold text-white">ဗိဿနိုး</h3>
                </div>
                <div class="p-6">
                    <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-3">မကွေးတိုင်းဒေသကြီး၊
                        တောင်တွင်းကြီးမြို့နယ်တွင် တည်ရှိပြီး ပျူယဉ်ကျေးမှု၏ အစောဆုံးကာလများကို လေ့လာနိုင်သော
                        မြို့ဟောင်းဖြစ်သည်။</p>
                    <a href="/history/cities"
                        class="inline-flex items-center text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">
                        အသေးစိတ်ဖတ်ရန်
                        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                            </path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Sri Ksetra Card -->
            <div
                class="group bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden transform hover:-translate-y-2 transition-all duration-300 border border-gray-100 dark:border-gray-700">
                <div class="relative h-64 overflow-hidden">
                    <img src="/sri_ksetra.webp" alt="Sri Ksetra"
                        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                    <h3 class="absolute bottom-4 left-6 text-2xl font-bold text-white">သရေခေတ္တရာ</h3>
                </div>
                <div class="p-6">
                    <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-3">ပဲခူးတိုင်းဒေသကြီး၊ ပြည်မြို့အနီးတွင်
                        တည်ရှိပြီး ပျူမြို့ဟောင်းများထဲတွင် စနစ်တကျ အကျယ်ပြန့်ဆုံးနှင့် အကြွယ်ဝဆုံး မြို့ဟောင်းဖြစ်သည်။
                    </p>
                    <a href="/history/cities"
                        class="inline-flex items-center text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">
                        အသေးစိတ်ဖတ်ရန်
                        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                            </path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- UNESCO Importance Section -->
        <div
            class="mt-24 bg-indigo-600 dark:bg-indigo-900 rounded-3xl p-8 md:p-12 text-white flex flex-col md:flex-row items-center justify-between shadow-2xl overflow-hidden relative">
            <div class="absolute top-0 right-0 -mt-20 -mr-20 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-64 h-64 bg-black/20 rounded-full blur-3xl"></div>

            <div class="md:w-2/3 relative z-10">
                <h2 class="text-3xl md:text-4xl font-bold mb-6">UNESCO ကမ္ဘာ့အမွေအနှစ်</h2>
                <p class="text-indigo-100 text-lg mb-8 leading-relaxed">
                    ၂၀၁၄ ခုနှစ်၊ ဇွန်လတွင် ကာတာနိုင်ငံ၊ ဒိုဟာမြို့၌ ကျင်းပခဲ့သော (၃၈) ကြိမ်မြောက် ကမ္ဘာ့အမွေအနှစ်
                    ကော်မတီညီလာခံမှ ဟန်လင်း၊ ဗိဿနိုးနှင့် သရေခေတ္တရာ ပျူမြို့ဟောင်း ၃ မြို့အား မြန်မာနိုင်ငံ၏ ပထမဆုံးသော
                    ကမ္ဘာ့အမွေအနှစ် နေရာများအဖြစ် သတ်မှတ်ခဲ့ပါသည်။
                </p>
                <div class="flex flex-wrap gap-4">
                    <span
                        class="px-4 py-2 bg-white/20 backdrop-blur-md rounded-lg text-sm font-semibold border border-white/30">Cultural
                        Heritage</span>
                    <span
                        class="px-4 py-2 bg-white/20 backdrop-blur-md rounded-lg text-sm font-semibold border border-white/30">Inscribed
                        in 2014</span>
                    <span
                        class="px-4 py-2 bg-white/20 backdrop-blur-md rounded-lg text-sm font-semibold border border-white/30">Outstanding
                        Universal Value</span>
                </div>
            </div>
            <div class="mt-12 md:mt-0 md:w-1/3 flex justify-center relative z-10">
                <div
                    class="w-48 h-48 border-4 border-white/30 rounded-full flex items-center justify-center animate-pulse">
                    <span class="text-xl font-bold text-center px-4">World Heritage Site</span>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer Section -->
    <footer
        class="bg-gray-100 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 transition-colors duration-300">
        <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
                <!-- Branding & Mission -->
                <div class="col-span-1 md:col-span-2">
                    <span class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">ပျူအမွေအနှစ်</span>
                    <p class="mt-4 text-gray-600 dark:text-gray-400 max-w-sm leading-relaxed">
                        ပျူအမွေအနှစ် ပရောဂျက်သည် မြန်မာနိုင်ငံ၏ ရှေးဦးယဉ်ကျေးမှုဖြစ်သော ပျူမြို့ပြနိုင်ငံများ၏
                        သမိုင်းကြောင်း၊ အနုပညာနှင့် နည်းပညာများကို နောင်လာနောက်သားများ လေ့လာနိုင်ရန်နှင့်
                        ထိန်းသိမ်းစောင့်ရှောက်ရန် ရည်ရွယ်ပါသည်။
                    </p>
                </div>

                <!-- Quick Links -->
                <div>
