    <script>
        const mapSources = {
            halin: 'https://www.google.com/maps?q=Halin+Ancient+City,+Wetlet,+Sagaing,+Myanmar&z=11&output=embed',
            beikthano: 'https://www.google.com/maps?q=Beikthano+Ancient+City,+Taungdwingyi,+Magway,+Myanmar&z=11&output=embed',
            sriksetra: 'https://www.google.com/maps?q=Sri+Ksetra+Ancient+City,+Pyay,+Bago,+Myanmar&z=11&output=embed'
        };

        const mapFrame = document.getElementById('pyu-map');
        const mapTabs = document.querySelectorAll('.map-tab');

        const activeTabClasses = ['bg-indigo-600', 'text-white', 'shadow'];
        const inactiveTabClasses = ['bg-white', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-200', 'border', 'border-gray-200', 'dark:border-gray-600', 'hover:bg-indigo-50', 'dark:hover:bg-gray-600'];

        const setTabState = (tab, isActive) => {
            tab.classList.remove(...activeTabClasses, ...inactiveTabClasses);
            if (isActive) {
                tab.classList.add(...activeTabClasses);
            } else {
                tab.classList.add(...inactiveTabClasses);
            }
        };

        mapTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const key = tab.dataset.map;
                if (!mapSources[key]) return;
                mapFrame.src = mapSources[key];
                mapTabs.forEach(t => setTabState(t, t === tab));
            });
            setTabState(tab, tab.dataset.map === 'halin');
        });
    </script>

