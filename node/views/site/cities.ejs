            <!-- Sri Ksetra Section -->
            <section class="flex flex-col lg:flex-row gap-8 items-center bg-gray-50 dark:bg-gray-800 p-6 md:p-8 rounded-3xl shadow-lg transition-transform duration-300 hover:shadow-xl">
