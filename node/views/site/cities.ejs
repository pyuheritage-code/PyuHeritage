            document.documentElement.classList.add('dark');
            lightIcon?.classList.remove('hidden');
            if (themeStatus) themeStatus.textContent = 'Dark';
        } else {
            document.documentElement.classList.remove('dark');
            darkIcon?.classList.remove('hidden');
            if (themeStatus) themeStatus.textContent = 'Light';
        }

        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('color-theme', 'light');
                lightIcon?.classList.add('hidden');
                darkIcon?.classList.remove('hidden');
                if (themeStatus) themeStatus.textContent = 'Light';
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('color-theme', 'dark');
                darkIcon?.classList.add('hidden');
                lightIcon?.classList.remove('hidden');
                if (themeStatus) themeStatus.textContent = 'Dark';
            }
        }

        themeToggleBtn?.addEventListener('click', toggleTheme);
        mobileThemeToggleBtn?.addEventListener('click', toggleTheme);

        // History Dropdown Toggle Logic
        const historyDropdownBtn = document.getElementById('history-dropdown-btn');
        const historyDropdownMenu = document.getElementById('history-dropdown-menu');
        const historyArrow = document.getElementById('history-arrow');

        historyDropdownBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = historyDropdownMenu.classList.contains('hidden');
            if (isHidden) {
                historyDropdownMenu.classList.remove('hidden');
                historyArrow.classList.add('rotate-180');
            } else {
                historyDropdownMenu.classList.add('hidden');
                historyArrow.classList.remove('rotate-180');
            }
        });

        window.addEventListener('click', (e) => {
            if (!historyDropdownBtn.contains(e.target) && !historyDropdownMenu.contains(e.target)) {
                historyDropdownMenu.classList.add('hidden');
                historyArrow.classList.remove('rotate-180');
            }
        });
    </script>
</body>

</html>