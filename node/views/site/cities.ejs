<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ပျူမြို့ပြနိုင်ငံများ - PyuHeritage</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>

<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white transition-colors duration-300 overflow-x-hidden">
    <!-- nav_section -->
    <nav
        class="bg-gray-100/80 dark:bg-gray-800/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex-shrink-0 flex items-center">
                    <a href="/" class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">ပျူအမွေအနှစ်</a>
                </div>

                <div class="hidden md:flex flex-1 justify-center space-x-8">
                    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium">ပင်မစာမျက်နှာ</a>
                    <a href="/chat"
                        class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium">ပျူအကြောင်းမေးမြန်းရန်</a>

                    <div class="relative">
                        <button id="history-dropdown-btn"
                            class="flex items-center text-indigo-600 dark:text-indigo-400 font-medium focus:outline-none transition-colors duration-200">
                            အကြောင်းအရာများ
                            <svg id="history-arrow" class="ml-1 w-4 h-4 rotate-180 transition-transform duration-200"
                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                        <div id="history-dropdown-menu"
                            class="absolute hidden left-0 mt-2 w-48 rounded-md shadow-lg bg-white dark:bg-gray-700 ring-1 ring-black ring-opacity-5 z-50">
                            <div class="py-1">
                                <a href="/history/cities"
                                    class="block px-4 py-2 text-sm bg-gray-100 dark:bg-gray-600 font-semibold">မြို့ပြနိုင်ငံများ</a>
                                <a href="/history/religion"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">သာသနာထွန်းကားမှု</a>
                                <a href="/history/language"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">ပျူဘာသာစကား
                                    နှင့် အက္ခရာ</a>
                                <a href="/history/culture"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">ယဉ်ကျေးမှု
                                    နှင့် ဘာသာရေး</a>
                                <a href="/history/artifacts"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">ရှေးဟောင်းသုတေသန
                                    ပစ္စည်းများ</a>
                                <a href="/history/artifacts/3d"
                                    class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600">3D
                                    ရှေးဟောင်းပစ္စည်းများ</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="hidden md:flex items-center space-x-3">
                    <% if (user) { %>
                        <%- include('partials/profile-menu') %>
                    <% } else { %>
                        <a href="/auth/signin" class="px-4 py-1.5 text-sm font-medium bg-indigo-600 hover:bg-indigo-700 text-white rounded-full shadow transition">Sign In</a>
                    <% } %>
                    <% if (!user) { %>
                    <button id="theme-toggle"
                        class="p-2 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 focus:outline-none">
                        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor"
                            viewBox="0 0 20 20">
                            <path
                                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z">
                            </path>
                        </svg>
                        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                        </svg>
                    </button>
                    <% } %>
                </div>

                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-button"
                        class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <div id="mobile-menu"
            class="hidden md:hidden bg-gray-100 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
            <div class="px-2 pt-2 pb-3 space-y-1">
                <a href="/"
                    class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ပင်မစာမျက်နှာ</a>
                <a href="/chat"
                    class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ပျူအကြောင်းမေးမြန်းရန်</a>
                <div class="space-y-1">
                    <button
                        class="w-full text-left px-3 py-2 text-base font-medium text-gray-600 dark:text-gray-300">အကြောင်းအရာများ<button>
                            <a href="/history/cities"
                                class="block pl-6 px-3 py-2 rounded-md text-sm font-semibold bg-gray-200 dark:bg-gray-700 text-indigo-600 dark:text-indigo-400">မြို့ပြနိုင်ငံများ</a>
                            <a href="/history/religion"
                                class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700">သာသနာထွန်းကားမှု</a>
                            <a href="/history/language"
                                class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ပျူဘာသာစကား
                                နှင့် အက္ခရာ</a>
                            <a href="/history/culture"
                                class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ယဉ်ကျေးမှု
                                နှင့် ဘာသာရေး</a>
                            <a href="/history/artifacts"
                                class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700">ရှေးဟောင်းသုတေသန
                                ပစ္စည်းများ</a>
                            <a href="/history/artifacts/3d"
                                class="block pl-6 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-700">3D
                                ရှေးဟောင်းပစ္စည်းများ</a>
                </div>
                <% if (user) { %>
                    <div class="px-3 py-3 flex items-center space-x-3 border-b border-gray-200 dark:border-gray-700">
                        <% if (user.picture) { %>
                            <img src="<%= user.picture %>" alt="<%= user.name %>" class="w-9 h-9 rounded-full object-cover">
                        <% } else { %>
                            <span class="w-9 h-9 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold"><%= user.name ? user.name[0].toUpperCase() : 'U' %></span>
                        <% } %>
                        <span class="text-base font-medium truncate"><%= user.name %></span>
                    </div>
                    <button id="mobile-change-username-btn" class="w-full text-left px-3 py-2 rounded-md text-base font-medium hover:bg-gray-200 dark:hover:bg-gray-700">Change Username</button>
                    <a href="/auth/logout" class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-200 dark:hover:bg-gray-700">Logout</a>
                <% } else { %>
                    <a href="/auth/signin" class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-200 dark:hover:bg-gray-700">Sign In</a>
                <% } %>
                <button id="mobile-theme-toggle"
                    class="w-full text-left px-3 py-2 rounded-md text-base font-medium hover:bg-gray-200 dark:hover:bg-gray-700 flex justify-between items-center">
                    <span>Theme</span>
                    <span id="theme-status" class="text-sm text-gray-500">Light</span>
                </button>
            </div>
        </div>
    </nav>
    <% if (user) { %>
    <%- include('partials/profile-modal') %>
    <% } %>
    <!-- /nav_section -->

    <!-- Header Banner -->
    <header class="bg-indigo-900 text-white py-16 px-4 text-center relative overflow-hidden">
        <div class="absolute inset-0 opacity-20 bg-cover bg-center" style="background-image: url('/sri_ksetra.webp');">
        </div>
        <div class="relative z-10 max-w-4xl mx-auto">
            <h1 class="text-3xl md:text-5xl font-extrabold mb-4">ပျူမြို့ဟောင်း သုံးမြို့ (UNESCO ကမ္ဘာ့အမွေအနှစ်)</h1>
            <p class="text-indigo-200 text-lg md:text-xl">မြန်မာနိုင်ငံ၏ ပထမဆုံးသော ယူနက်စကို ကမ္ဘာ့အမွေအနှစ်စာရင်းဝင်
                ရှေးဦးပျူမြို့ပြနိုင်ငံကြီးများအကြောင်း သမိုင်းမှတ်တမ်း</p>
        </div>
    </header>

    <!-- Location Map Section (Google Maps) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12">
        <div class="bg-gray-50 dark:bg-gray-800 p-6 md:p-8 rounded-3xl shadow-lg">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-2 text-center">
                ပျူမြို့ဟောင်း သုံးမြို့ တည်နေရာ မြေပုံ</h2>
            <p class="text-gray-600 dark:text-gray-300 text-center mb-6">
                မြန်မာနိုင်ငံ၏ လက်ရှိနယ်မြေပေါ်တွင် ပျူမြို့ဟောင်း သုံးမြို့ တည်ရှိနေသည့် နေရာများ</p>
            <div class="flex flex-wrap justify-center gap-3 mb-6" role="tablist">
                <button data-map="halin"
                    class="map-tab px-5 py-2 rounded-full text-sm font-semibold transition-colors duration-200">ဟန်လင်း</button>
                <button data-map="beikthano"
                    class="map-tab px-5 py-2 rounded-full text-sm font-semibold transition-colors duration-200">ဗိဿနိုး</button>
                <button data-map="sriksetra"
                    class="map-tab px-5 py-2 rounded-full text-sm font-semibold transition-colors duration-200">သရေခေတ္တရာ</button>
            </div>
            <div
                class="w-full h-[420px] md:h-[500px] rounded-2xl shadow-md overflow-hidden border border-gray-200 dark:border-gray-700">
                <iframe id="pyu-map" title="ပျူမြို့ဟောင်း မြေပုံ"
                    src="https://www.google.com/maps?q=Halin+Ancient+City,+Wetlet,+Sagaing,+Myanmar&z=11&output=embed"
                    class="w-full h-full border-0" allowfullscreen loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </section>

    <!-- Main Content Grid -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <article class="space-y-16">

            <!-- Halin Card -->
            <section
                class="bg-gray-50 dark:bg-gray-800 rounded-3xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
                <div class="relative">
                    <img src="/halin.webp" alt="Halin City"
                        class="w-full h-64 md:h-80 object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                    <span
                        class="absolute top-4 left-4 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-indigo-600/90 text-white rounded-full shadow">Sagaing
                        Region</span>
                    <div class="absolute bottom-4 left-5 right-5">
                        <h2 class="text-2xl md:text-3xl font-bold text-white drop-shadow">ဟန်လင်းမြို့ဟောင်း <span
                                class="text-base md:text-lg font-normal text-gray-200">(Halin Ancient City)</span></h2>
                    </div>
                </div>
                <div class="p-6 md:p-8 space-y-4">
                    <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                        ဟန်လင်းမြို့ဟောင်းသည် စစ်ကိုင်းတိုင်းဒေသကြီး၊ ဝက်လက်မြို့နယ်တွင် တည်ရှိပြီး
                        ပျူမြို့ပြနိုင်ငံများတွင် အစောဆုံးနှင့် သမိုင်းဝင် အရေးပါသော မြို့ကြီးတစ်မြို့ ဖြစ်သည်။
                        စတုဂံပုံ အုတ်မြို့ရိုးနှင့် စနစ်တကျ တည်ဆောက်ထားသော ရေသွင်းစနစ်များကြောင့် ထင်ရှားသည်။
                    </p>
                    <details class="group">
                        <summary
                            class="inline-flex items-center gap-1 text-indigo-600 dark:text-indigo-400 font-semibold cursor-pointer select-none hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors duration-200">
                            <span class="group-open:hidden">ပိုများစွာဖတ်ရန် ▾</span>
                            <span class="hidden group-open:inline">လျှော့ကြည့်ရန် ▴</span>
                        </summary>
                        <div class="space-y-4 pt-4">
                            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                                တူးဖော်မှုများအရ ရှေးဟောင်း ရွှေထည်၊ ငွေထည်၊ ပျူသင်္ကေတပါသော ဒင်္ဂါးပြားများနှင့်
                                ကျောက်မျက်ရတနာ
                                ပုတီးစေ့များစွာကို တွေ့ရှိရသဖြင့် ဟန်လင်းသည် ကုန်သွယ်ရေးနှင့် ယဉ်ကျေးမှု ထွန်းကားရာ
                                ဗဟိုချက်မ
                                ဖြစ်ခဲ့ကြောင်း သက်သေပြနေသည်။
                            </p>
                            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                                သမိုင်းပညာရှင်များ၏ ခန့်မှန်းချက်အရ ဟန်လင်းမြို့ဟောင်းသည် ဘီစီ ၂ ရာစုမှ အေဒီ ၁၁
                                ရာစုအထိ
                                နေထိုင်သည်ဟု ယူဆရသည်။ မြို့ရိုးစည်သည် အလျား ၁.၄ ကီလိုမီတာခန့် ရှိပြီး မြို့တွင်းရှိ
                                ရေကန်များ၊ ရေတွင်းများနှင့် ရေသွင်းတူးမြောင်းစနစ်သည် ပျူတို့၏ အင်ဂျင်နီယာပညာကို
                                ထင်ရှားစေသည်။ ၂၀၁၅ ခုနှစ်တွင် ယူနက်စကို ကမ္ဘာ့အမွေအနှစ်နေရာ စာရင်းတွင်
                                သရေခေတ္တရာနှင့်
                                ဗိဿနိုးတို့နှင့်အတူ "ပျူရှေးမြို့ဟောင်းများ" (Pyu Ancient Cities) အဖြစ် တရားဝင်
                                ထည့်သွင်းခြင်း ခံရသည်။ ထို့အပြင် ဟန်လင်းမှ တွေ့ရှိသော ကျောက်စာများတွင် ပျူအက္ခရာများ
                                ရေးထိုးထားပြီး မြန်မာနိုင်ငံရှိ အစောဆုံး အက္ခရာမှတ်တမ်းများထဲမှ တစ်ခု ဖြစ်သည်။
                            </p>
                        </div>
                    </details>
                    <div class="flex flex-wrap gap-2 pt-1">
                        <span
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-full border border-gray-200 dark:border-gray-600">
                            📍 ဝက်လက်မြို့နယ်
                        </span>
                        <span
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-full border border-gray-200 dark:border-gray-600">
                            🕐 ဘီစီ ၂ ရာစု – အေဒီ ၁၁ ရာစု
                        </span>
                        <span
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-full border border-gray-200 dark:border-gray-600">
                            🌍 UNESCO ၂၀၁၅
                        </span>
                        <a href="https://www.google.com/maps/search/Halin+Ancient+City,+Wetlet,+Sagaing,+Myanmar"
                            target="_blank" rel="noopener"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 rounded-full border border-indigo-200 dark:border-indigo-800 hover:bg-indigo-50 dark:hover:bg-indigo-900/40 transition-colors duration-200">
                            🗺️ Google Maps တွင် ဖွင့်ရန်
                        </a>
                    </div>
                </div>
            </section>

            <!-- Beikthano Card -->
            <section
                class="bg-gray-50 dark:bg-gray-800 rounded-3xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
                <div class="relative">
                    <img src="/beikthano.webp" alt="Beikthano"
                        class="w-full h-64 md:h-80 object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                    <span
                        class="absolute top-4 left-4 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-indigo-600/90 text-white rounded-full shadow">Magway
                        Region</span>
                    <div class="absolute bottom-4 left-5 right-5">
