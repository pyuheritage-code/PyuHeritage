<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Admin Dashboard - PyuHeritage</title>
    <meta name="description"
        content="PyuHeritage Admin Dashboard - Manage artifacts and 3D artifact models">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }

        /* Sidebar drawer animation */
        .sidebar-transition {
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .sidebar-overlay {
            transition: opacity 0.3s ease;
        }

        /* Content section transitions */
        .content-section {
            display: none;
            animation: fadeSlideIn 0.4s ease-out;
        }

        .content-section.active {
            display: block;
        }

        @keyframes fadeSlideIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Modal animation */
        .modal-overlay {
            transition: opacity 0.3s ease;
        }

        .modal-content {
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
        }

        .modal-overlay.hidden .modal-content {
            transform: scale(0.95) translateY(10px);
            opacity: 0;
        }

        /* Stat card hover glow */
        .stat-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.15);
        }

        .stat-card:active {
            transform: scale(0.97);
        }

        /* Table row hover */
        .table-row-hover {
            transition: background-color 0.15s ease;
        }

        /* Mobile bottom nav */
        .bottom-nav-btn {
            transition: all 0.2s ease;
            -webkit-tap-highlight-color: transparent;
        }

        .bottom-nav-btn:active {
            transform: scale(0.9);
        }

        /* Scrollbar styling */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .dark ::-webkit-scrollbar-thumb {
            background: #475569;
        }

        .dark ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }

        /* Nav link hover effect */
        .nav-link {
            position: relative;
            transition: all 0.2s ease;
        }

        .nav-link::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: #6366f1;
            border-radius: 0 4px 4px 0;
            transform: scaleY(0);
            transition: transform 0.2s ease;
        }

        .nav-link:hover::before,
        .nav-link.active::before {
            transform: scaleY(1);
        }

        /* Glassmorphism overlay */
        .glass {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .dark .glass {
            background: rgba(30, 41, 59, 0.8);
        }

        /* Pulse dot animation */
        @keyframes pulse-dot {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }
        }

        .pulse-dot {
            animation: pulse-dot 2s ease-in-out infinite;
        }

        /* Swipe indicator */
        @keyframes swipeHint {

            0%,
            100% {
                transform: translateX(0);
                opacity: 0.4;
            }

            50% {
                transform: translateX(8px);
                opacity: 1;
            }
        }

        .swipe-hint {
            animation: swipeHint 2s ease-in-out infinite;
        }

        /* Safe area bottom for mobile */
        .pb-safe {
            padding-bottom: env(safe-area-inset-bottom, 0px);
        }

        /* Mobile card table styling */
        .mobile-card {
            transition: all 0.2s ease;
        }

        .mobile-card:active {
            transform: scale(0.98);
        }

        /* Prevent body scroll when sidebar open on mobile */
        body.sidebar-open {
            overflow: hidden;
        }
    </style>
</head>

<body
    class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white transition-colors duration-300 overflow-x-hidden pb-16 lg:pb-0">

    <!-- Mobile Sidebar Overlay -->
    <div id="sidebar-overlay"
        class="sidebar-overlay fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden opacity-0 lg:hidden"
        onclick="toggleSidebar()"></div>

    <!-- ==================== SIDEBAR DRAWER ==================== -->
    <aside id="sidebar"
        class="fixed top-0 left-0 h-full w-72 sm:w-80 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 z-50 sidebar-transition -translate-x-full lg:translate-x-0 lg:w-64 flex flex-col shadow-xl lg:shadow-md">

        <!-- Logo Area with Close Button -->
        <div class="px-4 sm:px-6 py-5 border-b border-gray-100 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div
                        class="w-9 h-9 sm:w-10 sm:h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/30 flex-shrink-0">
                        <svg class="w-5 h-5 sm:w-6 sm:h-6 text-white" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
                            </path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white leading-tight">
                            ပျူအမွေအနှစ်</h1>
                        <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">Admin Panel</p>
                    </div>
                </div>
                <!-- Close button - mobile only -->
                <button onclick="toggleSidebar()"
                    class="lg:hidden p-2 rounded-xl text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors -mr-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <p class="px-3 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-3">Main
                Menu</p>

            <button onclick="switchSection('dashboard')" data-section="dashboard"
                class="nav-link active w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
                    </path>
                </svg>
                <span>Dashboard</span>
            </button>

            <p class="px-3 pt-4 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-3">
                Content Management</p>

            <button onclick="switchSection('artifacts')" data-section="artifacts"
                class="nav-link w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700/50">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
                </svg>
                <span>Artifacts</span>
                <span id="sidebar-artifact-count"
                    class="ml-auto text-xs bg-cyan-100 dark:bg-cyan-900/50 text-cyan-600 dark:text-cyan-400 px-2 py-0.5 rounded-full font-semibold">
                    <%= artifactCount || 0 %>
                </span>
            </button>

            <button onclick="switchSection('3d-artifacts')" data-section="3d-artifacts"
                class="nav-link w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700/50">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"></path>
                </svg>
                <span>3D Artifacts</span>
                <span id="sidebar-three-d-artifact-count"
                    class="ml-auto text-xs bg-purple-100 dark:bg-purple-900/50 text-purple-600 dark:text-purple-400 px-2 py-0.5 rounded-full font-semibold">
                    <%= threeDArtifactCount || 0 %>
                </span>
            </button>
        </nav>

        <!-- Sidebar Footer -->
        <div class="px-3 py-3 border-t border-gray-100 dark:border-gray-700 space-y-1">
            <!-- Dark Mode Toggle -->
            <button id="theme-toggle"
                class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700/50 transition-colors">
                <svg id="theme-icon-sun" class="hidden w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
                    <path
                        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z">
                    </path>
                </svg>
                <svg id="theme-icon-moon" class="hidden w-5 h-5 text-indigo-400" fill="currentColor"
                    viewBox="0 0 20 20">
                    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                </svg>
                <span id="theme-label">Dark Mode</span>
            </button>

            <!-- View Site Link -->
            <a href="/"
                class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700/50 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
                <span>View Site</span>
            </a>
        </div>
    </aside>

    <!-- ==================== MAIN CONTENT ==================== -->
    <div id="main-content" class="lg:ml-64 min-h-screen transition-all duration-300">

        <!-- Top Header Bar -->
        <header class="sticky top-0 z-30 glass border-b border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between px-3 sm:px-6 lg:px-8 h-14 sm:h-16">
                <!-- Left: Hamburger + Page Title -->
                <div class="flex items-center space-x-2 sm:space-x-4 min-w-0">
                    <button id="sidebar-toggle" onclick="toggleSidebar()"
                        class="lg:hidden p-2 rounded-xl text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none transition-colors flex-shrink-0">
                        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                    <div class="min-w-0">
                        <h2 id="page-title"
                            class="text-base sm:text-xl font-bold text-gray-900 dark:text-white truncate">Dashboard</h2>
                        <p id="page-subtitle" class="text-xs text-gray-500 dark:text-gray-400 hidden sm:block">Overview
                            & Analytics</p>
                    </div>
                </div>

                <!-- Right: Search + Actions -->
                <div class="flex items-center space-x-1 sm:space-x-3">
                    <!-- Search - hidden on very small -->
                    <div
                        class="hidden md:flex items-center bg-gray-100 dark:bg-gray-700/50 rounded-xl px-3 py-2 space-x-2 border border-transparent focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-500/20 transition-all">
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input type="text" placeholder="Search..."
                            class="bg-transparent text-sm text-gray-700 dark:text-gray-200 placeholder-gray-400 focus:outline-none w-32 lg:w-56">
                    </div>

                    <!-- Search icon - mobile only -->
                    <button
                        class="md:hidden p-2 rounded-xl text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>

                    <!-- Notification Bell -->
                    <button
                        class="relative p-2 rounded-xl text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                            </path>
                        </svg>
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full pulse-dot"></span>
                    </button>

                    <!-- Admin Avatar - hide name on mobile -->
                    <div class="flex items-center space-x-2 pl-1 sm:pl-2 border-l border-gray-200 dark:border-gray-700">
                        <div
                            class="w-7 h-7 sm:w-8 sm:h-8 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full flex items-center justify-center">
                            <span class="text-white text-xs font-bold">A</span>
                        </div>
                        <span class="hidden sm:block text-sm font-medium text-gray-700 dark:text-gray-300">Admin</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- ==================== CONTENT SECTIONS ==================== -->
        <main class="p-3 sm:p-6 lg:p-8">

            <!-- ===== DASHBOARD OVERVIEW ===== -->
            <div id="section-dashboard" class="content-section active">
                <!-- Stats Cards Grid -->
                                <div class="grid grid-cols-2 gap-3 sm:gap-6 mb-6 sm:mb-8">
                    <!-- Artifacts Stat -->
                    <div class="stat-card bg-gradient-to-br from-cyan-500 to-blue-700 rounded-xl sm:rounded-2xl p-4 sm:p-5 text-white shadow-lg shadow-cyan-500/20 cursor-pointer active:scale-95 transition-transform"
                        onclick="switchSection('artifacts')">
                        <div class="flex items-center justify-between mb-3 sm:mb-4">
                            <div
                                class="w-8 h-8 sm:w-10 sm:h-10 bg-white/20 rounded-lg sm:rounded-xl flex items-center justify-center backdrop-blur-sm">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4">
                                    </path>
                                </svg>
                            </div>
                            <svg class="w-3 h-3 sm:w-4 sm:h-4 opacity-60 hidden sm:block" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                                </path>
                            </svg>
                        </div>
                        <p id="stat-artifact-count" class="text-xl sm:text-3xl font-extrabold">
                            <%= artifactCount || 0 %>
                        </p>
                        <p class="text-xs sm:text-sm text-cyan-100 font-medium mt-0.5 sm:mt-1">Artifacts</p>
                    </div>

                    <!-- 3D Artifacts Stat -->
                    <div class="stat-card bg-gradient-to-br from-purple-500 to-violet-700 rounded-xl sm:rounded-2xl p-4 sm:p-5 text-white shadow-lg shadow-purple-500/20 cursor-pointer active:scale-95 transition-transform"
                        onclick="switchSection('3d-artifacts')">
                        <div class="flex items-center justify-between mb-3 sm:mb-4">
                            <div
                                class="w-8 h-8 sm:w-10 sm:h-10 bg-white/20 rounded-lg sm:rounded-xl flex items-center justify-center backdrop-blur-sm">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"></path>
                                </svg>
                            </div>
                            <svg class="w-3 h-3 sm:w-4 sm:h-4 opacity-60 hidden sm:block" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                                </path>
                            </svg>
                        </div>
                        <p id="stat-three-d-artifact-count" class="text-xl sm:text-3xl font-extrabold">
                            <%= threeDArtifactCount || 0 %>
                        </p>
                        <p class="text-xs sm:text-sm text-purple-100 font-medium mt-0.5 sm:mt-1">3D Artifacts</p>
                    </div>
                </div>

                <!-- Quick Actions + Recent Activity -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
                    <!-- Quick Actions -->
                    <div
                        class="bg-white dark:bg-gray-800 rounded-xl sm:rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 sm:p-6">
                        <h3
                            class="text-base sm:text-lg font-bold text-gray-900 dark:text-white mb-3 sm:mb-4 flex items-center">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2 text-indigo-500" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                            Quick Actions
                        </h3>
                        <div class="space-y-2">
                            <button onclick="switchSection('artifacts'); setTimeout(()=>openModal('artifacts'), 300)"
                                class="w-full flex items-center space-x-3 px-3 sm:px-4 py-2.5 sm:py-3 rounded-xl text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-700/50 hover:bg-cyan-50 dark:hover:bg-cyan-900/20 hover:text-cyan-600 dark:hover:text-cyan-400 transition-all active:scale-[0.98]">
                                <span
                                    class="w-7 h-7 sm:w-8 sm:h-8 bg-cyan-100 dark:bg-cyan-900/50 rounded-lg flex items-center justify-center flex-shrink-0"><svg
                                        class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-cyan-600 dark:text-cyan-400" fill="none"
                                        stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 4v16m8-8H4"></path>
                                    </svg></span>
                                <span>Add New Artifact</span>
                            </button>
                            <button onclick="switchSection('3d-artifacts'); setTimeout(()=>document.querySelector('[onclick*=\"open3DArtifactModal\"]')?.click(), 300)"
                                class="w-full flex items-center space-x-3 px-3 sm:px-4 py-2.5 sm:py-3 rounded-xl text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-700/50 hover:bg-purple-50 dark:hover:bg-purple-900/20 hover:text-purple-600 dark:hover:text-purple-400 transition-all active:scale-[0.98]">
                                <span
                                    class="w-7 h-7 sm:w-8 sm:h-8 bg-purple-100 dark:bg-purple-900/50 rounded-lg flex items-center justify-center flex-shrink-0"><svg
                                        class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-purple-600 dark:text-purple-400" fill="none"
                                        stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 4v16m8-8H4"></path>
                                    </svg></span>
                                <span>Add New 3D Artifact</span>
                            </button>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div
