<!-- ===== CITIES SECTION ===== -->
<div id="section-cities" class="content-section">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 space-y-3 sm:space-y-0">
        <div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Manage Cities</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Add, edit, or remove Pyu ancient city records</p>
        </div>
        <button onclick="openModal('cities')" class="inline-flex items-center px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-lg shadow-indigo-500/30 transition-all hover:shadow-indigo-500/40 hover:-translate-y-0.5">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add New City
        </button>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm" id="cities-table">
                <thead class="bg-gray-50 dark:bg-gray-700/50">
                    <tr class="text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        <th class="px-6 py-4">ID</th>
                        <th class="px-6 py-4">Title</th>
                        <th class="px-6 py-4">Image</th>
                        <th class="px-6 py-4">Description</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    <tr class="table-row-hover hover:bg-gray-50 dark:hover:bg-gray-700/30">
                        <td class="px-6 py-4 text-gray-500 dark:text-gray-400 font-mono text-xs">1</td>
                        <td class="px-6 py-4 font-semibold text-gray-900 dark:text-white">ဟန်လင်း (Halin)</td>
                        <td class="px-6 py-4"><div class="w-12 h-12 rounded-lg bg-gray-200 dark:bg-gray-600 overflow-hidden"><img src="/halin.webp" alt="Halin" class="w-full h-full object-cover"></div></td>
                        <td class="px-6 py-4 text-gray-600 dark:text-gray-300 max-w-xs truncate">စစ်ကိုင်းတိုင်းဒေသကြီး၊ ဝက်လက်မြို့နယ်တွင် တည်ရှိပြီး ရှေးဟောင်းပျူမြို့ပြနိုင်ငံများထဲတွင် အကြီးဆုံးမြို့များထဲမှ တစ်ခုဖြစ်သည်။</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end space-x-2">
                                <button onclick="openModal('cities', 1)" class="p-2 rounded-lg text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors" title="Edit"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg></button>
                                <button onclick="confirmDelete('cities', 1)" class="p-2 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors" title="Delete"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                            </div>
                        </td>
                    </tr>
                    <tr class="table-row-hover hover:bg-gray-50 dark:hover:bg-gray-700/30">
                        <td class="px-6 py-4 text-gray-500 dark:text-gray-400 font-mono text-xs">2</td>
                        <td class="px-6 py-4 font-semibold text-gray-900 dark:text-white">ဗိဿနိုး (Beikthano)</td>
                        <td class="px-6 py-4"><div class="w-12 h-12 rounded-lg bg-gray-200 dark:bg-gray-600 overflow-hidden"><img src="/beikthano.webp" alt="Beikthano" class="w-full h-full object-cover"></div></td>
                        <td class="px-6 py-4 text-gray-600 dark:text-gray-300 max-w-xs truncate">မကွေးတိုင်းဒေသကြီး၊ တောင်တွင်းကြီးမြို့နယ်တွင် တည်ရှိပြီး ပျူယဉ်ကျေးမှု၏ အစောဆုံးကာလများကို လေ့လာနိုင်သော မြို့ဟောင်းဖြစ်သည်။</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end space-x-2">
                                <button onclick="openModal('cities', 2)" class="p-2 rounded-lg text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors" title="Edit"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg></button>
                                <button onclick="confirmDelete('cities', 2)" class="p-2 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors" title="Delete"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                            </div>
                        </td>
                    </tr>
                    <tr class="table-row-hover hover:bg-gray-50 dark:hover:bg-gray-700/30">
                        <td class="px-6 py-4 text-gray-500 dark:text-gray-400 font-mono text-xs">3</td>
                        <td class="px-6 py-4 font-semibold text-gray-900 dark:text-white">သရေခေတ္တရာ (Sri Ksetra)</td>
                        <td class="px-6 py-4"><div class="w-12 h-12 rounded-lg bg-gray-200 dark:bg-gray-600 overflow-hidden"><img src="/sri_ksetra.webp" alt="Sri Ksetra" class="w-full h-full object-cover"></div></td>
                        <td class="px-6 py-4 text-gray-600 dark:text-gray-300 max-w-xs truncate">ပဲခူးတိုင်းဒေသကြီး၊ ပြည်မြို့အနီးတွင် တည်ရှိပြီး ပျူမြို့ဟောင်းများထဲတွင် စနစ်တကျ အကျယ်ပြန့်ဆုံးနှင့် အကြွယ်ဝဆုံး မြို့ဟောင်းဖြစ်သည်။</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end space-x-2">
                                <button onclick="openModal('cities', 3)" class="p-2 rounded-lg text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors" title="Edit"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg></button>
                                <button onclick="confirmDelete('cities', 3)" class="p-2 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors" title="Delete"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
