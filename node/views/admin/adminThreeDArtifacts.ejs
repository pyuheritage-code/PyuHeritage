<!-- ===== 3D ARTIFACTS SECTION ===== -->
<div id="section-3d-artifacts" class="content-section">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 space-y-3 sm:space-y-0">
        <div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Manage 3D Artifacts</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Add, edit, or remove 3D artifact models</p>
        </div>
        <button onclick="open3DArtifactModal()"
            class="inline-flex items-center px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-lg shadow-indigo-500/30 transition-all hover:shadow-indigo-500/40 hover:-translate-y-0.5">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Add New 3D Artifact
        </button>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-gray-700/50">
                    <tr class="text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        <th class="px-6 py-4">ID</th>
                        <th class="px-6 py-4">Title</th>
                        <th class="px-6 py-4">Image</th>
                        <th class="px-6 py-4">3D Model</th>
                        <th class="px-6 py-4">Description</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="three-d-artifacts-table-body" class="divide-y divide-gray-100 dark:divide-gray-700">
                    <% if (threeDArtifacts && threeDArtifacts.length > 0) { %>
                        <% threeDArtifacts.forEach(function(a) { %>
                            <tr class="table-row-hover hover:bg-gray-50 dark:hover:bg-gray-700/30" data-id="<%= a.id %>">
                                <td class="px-6 py-4 text-gray-500 dark:text-gray-400 font-mono text-xs"><%= a.id %></td>
                                <td class="px-6 py-4 font-semibold text-gray-900 dark:text-white"><%= a.title %></td>
                                <td class="px-6 py-4">
                                    <% if (a.image_url) { %>
                                        <img src="<%= a.image_url %>" alt="<%= a.title %>" class="w-12 h-12 rounded-lg object-cover">
                                    <% } else { %>
                                        <div class="w-12 h-12 rounded-lg bg-gray-200 dark:bg-gray-600 flex items-center justify-center">
                                            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                            </svg>
                                        </div>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4">
                                    <% if (a.model_url) { %>
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">
                                            <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"></path>
                                            </svg>
                                            .glb
                                        </span>
                                    <% } else { %>
                                        <span class="text-gray-400 dark:text-gray-500 text-xs">No model</span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 text-gray-600 dark:text-gray-300 max-w-xs truncate"><%= a.description %></td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end space-x-2">
                                        <button onclick="open3DArtifactModal('<%= a.id %>')"
                                            class="p-2 rounded-lg text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors" title="Edit">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                            </svg>
                                        </button>
                                        <button onclick="confirmDelete3DArtifact('<%= a.id %>')"
                                            class="p-2 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors" title="Delete">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr id="no-three-d-artifacts-row">
                            <td colspan="6" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                                No 3D artifacts found. Click "Add New 3D Artifact" to get started.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== 3D ARTIFACT ADD/EDIT MODAL ==================== -->
<div id="three-d-artifact-modal-overlay"
    class="modal-overlay fixed inset-0 bg-black/50 backdrop-blur-sm z-[60] hidden flex items-end sm:items-center justify-center p-0 sm:p-4"
    onclick="close3DArtifactModal(event)">
    <div class="modal-content bg-white dark:bg-gray-800 rounded-t-2xl sm:rounded-2xl shadow-2xl w-full sm:max-w-lg max-h-[90vh] overflow-y-auto border-gray-200 dark:border-gray-700 sm:border"
        onclick="event.stopPropagation()">
        <div class="flex items-center justify-between px-4 sm:px-6 py-3 sm:py-4 border-b border-gray-100 dark:border-gray-700 sticky top-0 bg-white dark:bg-gray-800 z-10">
            <h3 id="three-d-artifact-modal-title" class="text-base sm:text-lg font-bold text-gray-900 dark:text-white">Add New 3D Artifact</h3>
            <button onclick="close3DArtifactModal()"
                class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <form id="three-d-artifact-modal-form" class="p-4 sm:p-6 space-y-4 sm:space-y-5" onsubmit="submit3DArtifactForm(event)" enctype="multipart/form-data">
            <input type="hidden" id="three-d-artifact-form-id" name="id" value="">

            <div>
                <label for="three-d-artifact-form-title" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Title</label>
                <input type="text" id="three-d-artifact-form-title" name="title" placeholder="Enter title..." required
                    class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all text-sm">
            </div>

            <div>
                <label for="three-d-artifact-form-description" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Description</label>
                <textarea id="three-d-artifact-form-description" name="description" rows="4" placeholder="Enter description..." required
                    class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all text-sm resize-none"></textarea>
            </div>

            <div>
                <label for="three-d-artifact-form-image" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Thumbnail Image</label>
                <input type="file" id="three-d-artifact-form-image" name="image" accept="image/jpeg,image/jpg,image/png,image/webp,image/gif"
                    class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 dark:file:bg-indigo-900/30 file:text-indigo-600 dark:file:text-indigo-400 hover:file:bg-indigo-100 dark:hover:file:bg-indigo-900/50 file:cursor-pointer file:transition-colors">
            </div>

            <div>
                <label for="three-d-artifact-form-model" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">3D Model (.glb)</label>
                <input type="file" id="three-d-artifact-form-model" name="model" accept=".glb,model/gltf-binary"
                    class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-purple-50 dark:file:bg-purple-900/30 file:text-purple-600 dark:file:text-purple-400 hover:file:bg-purple-100 dark:hover:file:bg-purple-900/50 file:cursor-pointer file:transition-colors">
                <p class="text-xs text-gray-400 mt-1">Upload .glb files only (max 100MB)</p>
            </div>

            <div class="flex items-center justify-end space-x-3 pt-2">
                <button type="button" onclick="close3DArtifactModal()"
                    class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                    Cancel
                </button>
                <button type="submit"
                    class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-500/30 transition-all hover:shadow-indigo-500/40">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== 3D ARTIFACT DELETE CONFIRMATION MODAL ==================== -->
<div id="three-d-artifact-delete-modal"
    class="modal-overlay fixed inset-0 bg-black/50 backdrop-blur-sm z-[60] hidden flex items-center justify-center p-4"
    onclick="closeDelete3DArtifactModal(event)">
    <div class="modal-content bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-sm border border-gray-200 dark:border-gray-700 p-6 text-center"
        onclick="event.stopPropagation()">
        <div class="w-14 h-14 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Delete 3D Artifact?</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">This action cannot be undone. Are you sure you want to permanently delete this 3D artifact?</p>
        <div class="flex items-center justify-center space-x-3">
            <button onclick="closeDelete3DArtifactModal()"
                class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                Cancel
            </button>
            <button id="confirm-delete-three-d-artifact-btn"
                class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-red-600 hover:bg-red-700 shadow-lg shadow-red-500/30 transition-all">
                Delete
            </button>
        </div>
    </div>
</div>

<!-- ==================== 3D ARTIFACT TOAST NOTIFICATION ==================== -->
<div id="three-d-artifact-toast"
    class="fixed bottom-20 lg:bottom-6 right-3 left-3 sm:left-auto sm:right-6 z-[70] transform translate-y-20 opacity-0 transition-all duration-500 pointer-events-none">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 px-4 py-3 flex items-center space-x-3">
        <div id="three-d-artifact-toast-icon"
            class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
        </div>
        <p id="three-d-artifact-toast-message" class="text-sm font-medium text-gray-900 dark:text-white">Action completed successfully!</p>
    </div>
</div>

<script>
    const threeDModalOverlay = document.getElementById('three-d-artifact-modal-overlay');
    const threeDModalTitle = document.getElementById('three-d-artifact-modal-title');
    const threeDFormId = document.getElementById('three-d-artifact-form-id');
    const threeDFormTitle = document.getElementById('three-d-artifact-form-title');
    const threeDFormDescription = document.getElementById('three-d-artifact-form-description');
    const threeDFormImage = document.getElementById('three-d-artifact-form-image');
    const threeDFormModel = document.getElementById('three-d-artifact-form-model');

    async function open3DArtifactModal(id = null) {
        threeDFormId.value = id || '';
        threeDFormTitle.value = '';
        threeDFormDescription.value = '';
        threeDFormImage.value = '';
        threeDFormModel.value = '';

        if (id) {
            try {
                const res = await fetch(`/admin/3d-artifacts/${id}`);
                const data = await res.json();
                if (data.id) {
                    threeDModalTitle.textContent = 'Edit 3D Artifact';
                    threeDFormTitle.value = data.title || '';
                    threeDFormDescription.value = data.description || '';
                } else {
                    threeDModalTitle.textContent = 'Add New 3D Artifact';
                }
            } catch (err) {
                threeDModalTitle.textContent = 'Add New 3D Artifact';
            }
        } else {
            threeDModalTitle.textContent = 'Add New 3D Artifact';
        }

        threeDModalOverlay.classList.remove('hidden');
        threeDModalOverlay.classList.add('flex');
        document.body.classList.add('overflow-hidden');
        setTimeout(() => threeDFormTitle.focus(), 200);
    }

    function close3DArtifactModal(e) {
        if (e && e.target !== threeDModalOverlay) return;
        threeDModalOverlay.classList.add('hidden');
        threeDModalOverlay.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
        document.getElementById('three-d-artifact-modal-form').reset();
    }

    async function submit3DArtifactForm(e) {
        e.preventDefault();
        const id = threeDFormId.value;
        const formData = new FormData(e.target);

        try {
            const url = id ? `/admin/3d-artifacts/${id}` : '/admin/3d-artifacts';
            const res = await fetch(url, { method: 'POST', body: formData });
            const data = await res.json();

            if (data.success) {
                close3DArtifactModal();
                show3DArtifactToast(`3D artifact ${id ? 'updated' : 'created'} successfully!`);
                setTimeout(() => location.reload(), 800);
            } else {
                show3DArtifactToast(data.error || 'Operation failed', 'delete');
            }
        } catch (err) {
            show3DArtifactToast('Network error: ' + err.message, 'delete');
        }
    }

    const threeDDeleteModal = document.getElementById('three-d-artifact-delete-modal');
    const confirmDelete3DBtn = document.getElementById('confirm-delete-three-d-artifact-btn');
    let pending3DDeleteId = null;

    function confirmDelete3DArtifact(id) {
        pending3DDeleteId = id;
        threeDDeleteModal.classList.remove('hidden');
        threeDDeleteModal.classList.add('flex');
        document.body.classList.add('overflow-hidden');
    }

    function closeDelete3DArtifactModal(e) {
        if (e && e.target !== threeDDeleteModal) return;
        threeDDeleteModal.classList.add('hidden');
        threeDDeleteModal.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
    }

    confirmDelete3DBtn.addEventListener('click', async () => {
        const id = pending3DDeleteId;
        closeDelete3DArtifactModal();

        if (!id) return;

        try {
            const res = await fetch(`/admin/3d-artifacts/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                show3DArtifactToast('3D artifact deleted successfully!', 'delete');
                setTimeout(() => location.reload(), 800);
            } else {
                show3DArtifactToast(data.error || 'Delete failed', 'delete');
            }
        } catch (err) {
            show3DArtifactToast('Network error: ' + err.message, 'delete');
        }
    });

    function show3DArtifactToast(message, type = 'success') {
        const toast = document.getElementById('three-d-artifact-toast');
        const msg = document.getElementById('three-d-artifact-toast-message');
        const icon = document.getElementById('three-d-artifact-toast-icon');

        msg.textContent = message;

        if (type === 'delete') {
            icon.innerHTML = '<svg class="w-4 h-4 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>';
            icon.className = 'w-8 h-8 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center flex-shrink-0';
        } else {
            icon.innerHTML = '<svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
            icon.className = 'w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0';
        }

        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
            toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            toast.classList.remove('translate-y-0', 'opacity-100');
        }, 3000);
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const modal = document.getElementById('three-d-artifact-modal-overlay');
            const delModal = document.getElementById('three-d-artifact-delete-modal');
            if (!modal.classList.contains('hidden')) close3DArtifactModal();
            if (!delModal.classList.contains('hidden')) closeDelete3DArtifactModal();
        }
    });
</script>
