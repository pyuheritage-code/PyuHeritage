PORT=3003

# MySQL database (set DB_SSL=true for cloud hosts like PlanetScale)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pyu
DB_SSL=false
# DB_CONNECTION_LIMIT=10

# RAG deployment mode (Vercel only; leave unset for local dev)
# RAG_DB_ONLY=true                 # load chunks from DB, skip local PDF indexing
# RAG_EMBED_API=true               # use OpenRouter embeddings instead of the local model
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# OpenRouter (for RAG chat + embeddings) - get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-YourKeyHere
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_SITE_URL=http://localhost:3003
OPENROUTER_SITE_NAME=PyuHeritage

# Vercel Blob (for uploads on Vercel; leave unset for local disk uploads)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Google OAuth - get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3003/auth/google/callback

# JWT for auth cookie - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me