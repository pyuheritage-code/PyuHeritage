PORT=3003

# MySQL database
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pyu

# OpenRouter (for RAG chat) - get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-YourKeyHere
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_SITE_URL=http://localhost:3003
OPENROUTER_SITE_NAME=PyuHeritage

# Google OAuth - get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3003/auth/google/callback

# JWT for auth cookie - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me